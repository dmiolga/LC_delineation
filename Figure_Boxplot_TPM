def expected_com_distance(p, q):
    p_com = center_of_mass(p)
    q_com = center_of_mass(q)
    return np.linalg.norm(np.array(p_com) - np.array(q_com))

def extract_author(filename):
    return filename.split("_c7coreg_")[0]

# Segmentation Processing
results_list = []

def process_segmentations(subfolder, results_list):
    subfolder_path = os.path.join(main_dir, subfolder)

    manual_file = next((f for f in os.listdir(subfolder_path) 
                        if f.startswith("manseg_") and f.endswith(".nii")), None)
    if not manual_file:
        print(f"Skipping {subfolder}: No manual segmentation found.")
        return

    manual_nii = nib.load(os.path.join(subfolder_path, manual_file))
    manual_data = (manual_nii.get_fdata() > 0).astype(np.uint8)

    nifti_files = [
        f for f in os.listdir(subfolder_path)
        if f.endswith(".nii") and not f.startswith(("AVEraged25_", "manseg_", "coreg_", "._", "w"))
    ]
    if not nifti_files:
        print(f"Skipping {subfolder}: No valid segmentation files found.")
        return

    for seg_file in nifti_files:
        seg_nii = nib.load(os.path.join(subfolder_path, seg_file))
        seg_data = seg_nii.get_fdata()

        if seg_data.shape != manual_data.shape:
            print(f"Skipping {seg_file} in {subfolder}: shape mismatch {manual_data.shape} vs {seg_data.shape}")
            continue

        author = extract_author(seg_file)

        # Compute metrics
        dice = soft_dice(manual_data, seg_data)
        vol_int = volume_intersection(manual_data, seg_data)
        corr = voxelwise_corr(manual_data, seg_data)
        com_dist = expected_com_distance(manual_data, seg_data)

        results_list.append({
            "Subject": subfolder,
            "Author": author,
            "Soft Dice": dice,
            "Volume Intersection": vol_int,
            "Voxelwise Correlation": corr,
            "COM Distance": com_dist
        })

# Run Over All Subfolders
subfolders = [f for f in os.listdir(main_dir) if os.path.isdir(os.path.join(main_dir, f))]

for subfolder in subfolders:
    process_segmentations(subfolder, results_list)

# Create Summary CSV with CI
df_all = pd.DataFrame(results_list)
df_all['Author'] = df_all['Author'].replace('Olga', 'group-level')

metrics = ['Soft Dice', 'Volume Intersection', 'Voxelwise Correlation', 'COM Distance']
summary_list = []

for metric in metrics:
    for author in df_all['Author'].unique():
        data = df_all[df_all['Author'] == author][metric].dropna()
        mean = data.mean()
        median = data.median()
        std = data.std()
        ci95 = 1.96 * std / np.sqrt(len(data)) if len(data) > 1 else np.nan  # 95% CI

        summary_list.append({
            "Author": author,
            "Metric": metric,
            "Mean": mean,
            "Median": median,
            "SD": std,
            "CI95": ci95
        })

df_summary = pd.DataFrame(summary_list)
df_summary.to_csv(os.path.join(main_dir, "metric_summary_with_CI.csv"), index=False)
print("Summary CSV with CI saved successfully.")

