# Metric Functions
def soft_dice(p, q):
    numerator = 2 * np.sum(p * q)
    denominator = np.sum(p**2) + np.sum(q**2)
    return numerator / denominator if denominator != 0 else 0

def volume_intersection(p, q):
    return np.sum(np.minimum(p, q))

def voxelwise_corr(p, q):
